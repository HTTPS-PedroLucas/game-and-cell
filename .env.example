# Copie para .env e ajuste
PORT=3000
NODE_ENV=development

# PostgreSQL (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@HOST:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Segredo da sessao do painel (32+ caracteres). Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# URL publica, usada no sitemap.xml
SITE_URL=

# Cloudinary. Prefira CLOUDINARY_URL; as três variáveis separadas também funcionam.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=game-and-cell
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Opcionais no primeiro `npm run db:migrate`. Remova do ambiente após criar o admin.
# ADMIN_NOME=Administrador
# ADMIN_EMAIL=voce@loja.com
# ADMIN_SENHA=troque-por-uma-senha-forte
